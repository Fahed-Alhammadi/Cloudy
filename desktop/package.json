{
  "name": "cloudy-desktop",
  "productName": "Cloudy",
  "version": "1.7.1",
  "description": "Cloudy desktop sync client: keeps a folder on your computer in sync with your Cloudy server.",
  "license": "MIT",
  "author": "Fahed Alhammadi",
  "homepage": "https://github.com/Fahed-Alhammadi/Cloudy",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "dist:mac": "npm run build && finder/build.sh && electron-builder --mac",
    "dist:win": "npm run build && node explorer/build.mjs && electron-builder --win",
    "dist:linux": "npm run build && linux/dolphin/build.sh && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "overrides": {
    "minimatch@^9.0.0": "11.0.8",
    "minimatch@^10.0.0": "11.0.8"
  }
}
