{
  "appId": "io.cloudy.desktop",
  "productName": "Cloudy",
  "copyright": "Copyright (c) 2026 Fahed Alhammadi",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "asar": true,
  "npmRebuild": false,
  "electronLanguages": [
    "en",
    "en-US"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "publish": [
    {
      "provider": "generic",
      "url": "https://github.com/Fahed-Alhammadi/Cloudy/releases/latest/download"
    }
  ],
  "mac": {
    "icon": "assets/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "notarize": false,
    "extendInfo": {
      "LSUIElement": true,
      "CFBundleIconName": "Icon"
    },
    "extraResources": [
      {
        "from": "assets/Assets.car",
        "to": "Assets.car"
      }
    ],
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "pkg",
        "arch": [
          "universal"
        ]
      }
    ],
    "x64ArchFiles": "Contents/PlugIns/CloudyFinder.appex/**"
  },
  "dmg": {
    "sign": true
  },
  "pkg": {
    "installLocation": "/Applications",
    "isRelocatable": false
  },
  "win": {
    "icon": "assets/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "explorer/build/CloudyBadges.dll",
        "to": "explorer/CloudyBadges.dll"
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "include": "explorer/installer.nsh"
  },
  "linux": {
    "icon": "assets/icon.png",
    "category": "Network",
    "synopsis": "Sync a folder with your Cloudy server",
    "maintainer": "Fahed Alhammadi <Fahed-Alhammadi@users.noreply.github.com>",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "linux/cloudy-badges.py",
        "to": "linux/cloudy-badges.py"
      },
      {
        "from": "linux/icons",
        "to": "linux/icons"
      },
      {
        "from": "linux/dolphin/build/${arch}/cloudyoverlay.so",
        "to": "linux/dolphin/cloudyoverlay.so"
      }
    ]
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libgbm1",
      "libasound2 | libasound2t64"
    ],
    "afterInstall": "linux/deb/after-install.sh",
    "afterRemove": "linux/deb/after-remove.sh"
  },
  "afterPack": "scripts/after-pack.cjs"
}
