PUID=1000
PGID=1000
CLOUDY_ADMIN_USERNAME=admin
CLOUDY_ADMIN_PASSWORD=change-me-to-a-long-password

# Optional:
# Your reverse proxy's address or range (CIDR); turns on real client IPs and HTTPS-only cookies
# TRUST_PROXY=172.16.0.0/12
# The address people open Cloudy at; passkeys and links in emails use it
# PUBLIC_URL=https://cloud.example.com
# Use your own PostgreSQL instead of the built-in one
# DATABASE_URL=postgres://user:password@host:5432/cloudy
