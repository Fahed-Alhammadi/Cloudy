<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the app is copied by cloud backup; a device-to-device transfer leaves the session (device
     token) and the app lock behind, so a new phone has to sign in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="applock.xml" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
